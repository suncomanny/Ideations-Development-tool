# Copy this file to a machine-local path when live connectors are added.
# Do not put real secrets in the shared SharePoint folder.
#
# Windows:
#   C:\Users\<user>\.sunco_ideation_development\.env
#
# macOS:
#   ~/.sunco_ideation_development/.env
#
# Example placeholders:
# POSTGRES_DSN=
# REDSHIFT_DSN=
# OPENAI_API_KEY=
